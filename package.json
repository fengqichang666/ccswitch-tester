{
  "name": "ccswitch-tester",
  "version": "0.2.0",
  "description": "Windows desktop tester for Claude and Codex providers configured in CC Switch",
  "author": "gale",
  "homepage": "https://github.com/fengqichang666/ccswitch-tester",
  "repository": {
    "type": "git",
    "url": "https://github.com/fengqichang666/ccswitch-tester.git"
  },
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis portable",
    "test": "node --test test/core.test.js test/request-client.test.js",
    "test:electron": "electron test/prompt-focus.electron.js",
    "test:tray": "node test/tray-smoke.js"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "sql.js": "^1.13.0",
    "undici": "^7.13.0"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.ccswitch.tester",
    "productName": "CCSwitch Tester",
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/@iarna/toml/**/*",
      "node_modules/sql.js/**/*",
      "node_modules/undici/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico",
      "artifactName": "CCSwitch-Tester-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CCSwitch-Tester-${version}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "CCSwitch-Tester-${version}-${arch}-portable.${ext}"
    }
  }
}
